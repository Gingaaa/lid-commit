; LidCommit Inno Setup Script
; Generates standard Windows Setup executable: LidCommit-Setup.exe

#define MyAppName "LidCommit"
#define MyAppVersion "0.4.1"
#define MyAppPublisher "Anshu Kumar"
#define MyAppURL "https://github.com/Gingaaa/lid-commit"
#define MyAppExeName "lid-commit.exe"

[Setup]
AppId={{9F82A45B-257C-4B91-8D1F-18DCE6B83742}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UsePreviousAppDir=yes
DisableProgramGroupPage=yes
LicenseFile=LICENSE
OutputDir=dist
OutputBaseFilename=LidCommit-Setup-x86_64
SetupIconFile=assets\app_icon.ico
Compression=lzma/max
SolidCompression=no
WizardStyle=modern
PrivilegesRequired=lowest
ArchitecturesInstallIn64BitMode=x64compatible
VersionInfoVersion=0.4.1.0
VersionInfoCompany=Anshu Kumar
VersionInfoDescription=LidCommit Setup Installer
VersionInfoProductName=LidCommit
VersionInfoProductVersion=0.4.1.0

; Smooth Reinstallation / In-place Upgrade Handling
CloseApplications=yes
RestartApplications=no
CloseApplicationsFilter=lid-commit.exe

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "startupicon"; Description: "Automatically launch LidCommit on Windows startup (Recommended)"; GroupDescription: "Windows Startup:"

[Files]
Source: "target\release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "assets\app_icon.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "config.example.toml"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\app_icon.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\app_icon.ico"; Tasks: desktopicon
Name: "{userstartup}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: startupicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; Stop running background daemon immediately before uninstall begins
Filename: "taskkill.exe"; Parameters: "/f /im {#MyAppExeName}"; Flags: runhidden; RunOnceId: "StopLidCommitDaemon"

[UninstallDelete]
; Clean up runtime files, logs, and WebView2 cache directories generated by the app in {app}
Type: filesandordirs; Name: "{app}\{#MyAppExeName}.WebView2"
Type: files; Name: "{app}\*.log"
Type: filesandordirs; Name: "{app}"

[Code]
// Gracefully terminate existing background daemon before installing or updating
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ResultCode: Integer;
begin
  Exec('taskkill.exe', '/f /im {#MyAppExeName}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Result := '';
end;

// Gracefully terminate existing daemon before uninstalling
function InitializeUninstall(): Boolean;
var
  ResultCode: Integer;
begin
  // Terminate any running instance of the application immediately
  Exec('taskkill.exe', '/f /im {#MyAppExeName}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  Sleep(500); // Give Windows time to release all file locks
  Result := True;
end;

// Post-uninstall: Ensure complete cleanup of installation folder and prompt for user config
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  AppDir: String;
  ConfigDir: String;
  ResultCode: Integer;
begin
  if CurUninstallStep = usUninstall then
  begin
    // Double-check daemon is dead before file deletion phase
    Exec('taskkill.exe', '/f /im {#MyAppExeName}', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
  end
  else if CurUninstallStep = usPostUninstall then
  begin
    // 1. Wipe out any leftovers in the installation directory (e.g. WebView2 cache, logs, temp files)
    AppDir := ExpandConstant('{app}');
    if DirExists(AppDir) then
    begin
      DelTree(AppDir, True, True, True);
    end;

    // 2. Prompt user whether to preserve or remove user configuration & API keys
    ConfigDir := ExpandConstant('{userappdata}\{#MyAppName}');
    if DirExists(ConfigDir) then
    begin
      if MsgBox('Do you also want to delete your LidCommit configuration, preferences, and saved API keys?' + #13#10 + #13#10 +
                'Select "Yes" to completely remove all data, or "No" to keep your settings for future reinstallation.', 
                mbConfirmation, MB_YESNO) = IDYES then
      begin
        DelTree(ConfigDir, True, True, True);
      end;
    end;
  end;
end;
