# Environment variables for LidCommit
# Copy this file to .env and fill in your values
# OR set these as system environment variables

# ── AI API Keys ───────────────────────────────────────────────────

# Gemini API key (get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (only needed if provider = "openai")
# OPENAI_API_KEY=your_openai_api_key_here

# ── Logging ───────────────────────────────────────────────────────

# Set log level: error | warn | info | debug | trace
# LIDCOMMIT_LOG=lid_commit=debug
